# Runtime
NEXT_PUBLIC_APP_NAME=AccelSSA
APP_ENV=development

# Operational / geospatial database (PostgreSQL + PostGIS target)
DATABASE_URL=postgresql://accelssa:accelssa@localhost:5432/accelssa

# Object storage adapter (provider-specific credentials remain server-side)
OBJECT_STORAGE_BUCKET=accelssa-development

# Job queue adapter. Leave unset when no durable queue adapter is connected.
JOB_QUEUE_URL=

# AI project assistant. Secrets must remain server-side.
# Supported provider in the current Category 12 adapter: openai
ACCELSSA_AI_PROVIDER=
ACCELSSA_AI_MODEL=
OPENAI_API_KEY=
