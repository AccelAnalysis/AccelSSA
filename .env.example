# Runtime
NEXT_PUBLIC_APP_NAME=AccelSSA
APP_ENV=development

# Operational / geospatial database (PostgreSQL + PostGIS remains authoritative)
DATABASE_URL=postgresql://accelssa:accelssa@localhost:5432/accelssa

# Firebase Authentication
# App Hosting supplies Firebase web-app configuration automatically when linked
# to the Firebase Web App. These NEXT_PUBLIC values are the local/manual fallback.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server Firebase project identity. App Hosting uses Application Default Credentials.
ACCELSSA_FIREBASE_PROJECT_ID=accelprocure
ACCELSSA_FIREBASE_APP_ID=1:479058229962:web:ea47507361c34560ea1233

# Local server development only: point to a service-account JSON file outside the repo
# when Application Default Credentials are otherwise unavailable.
GOOGLE_APPLICATION_CREDENTIALS=

# Object storage adapter (provider-specific credentials remain server-side)
OBJECT_STORAGE_BUCKET=accelssa-development

# Job queue adapter. Leave unset when no durable queue adapter is connected.
JOB_QUEUE_URL=

# AI project assistant. Secrets must remain server-side.
# Supported provider in the current Category 12 adapter: openai
ACCELSSA_AI_PROVIDER=
ACCELSSA_AI_MODEL=
OPENAI_API_KEY=
